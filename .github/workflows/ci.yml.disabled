name: CI

on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-and-test:
    name: Regenerate project + run suite
    runs-on: macos-latest
    timeout-minutes: 45
    defaults:
      run:
        # Gives every run step `bash -eo pipefail`, so xcodebuild's exit
        # status is never masked by output formatting.
        shell: bash
    steps:
      - uses: actions/checkout@v4

      - name: Check Pencil'd brand identity
        run: |
          python3 scripts/verify-brand-identity.py --worktree
          python3 scripts/tests/test_brand_identity_gate.py

      - name: Install XcodeGen
        run: brew install xcodegen

      # The core guard: Pencild.xcodeproj is GENERATED from project.yml.
      # Regenerating before every build means a file added to
      # Sources/Pencild or Tests/PencildTests is always compiled and
      # tested, even if the committed pbxproj was hand-edited and left
      # stale.
      - name: Regenerate Pencild.xcodeproj from project.yml
        run: xcodegen generate

      # Soft check (does not block): warns when the committed pbxproj
      # differs from fresh generator output.
      - name: Check committed pbxproj matches xcodegen output
        continue-on-error: true
        run: |
          if ! git diff --exit-code Pencild.xcodeproj; then
            echo "::warning file=Pencild.xcodeproj/project.pbxproj::Committed Pencild.xcodeproj differs from 'xcodegen generate' output. Run xcodegen locally and commit the result."
            exit 1
          fi

      - name: Pick an available iPhone simulator
        id: sim
        run: |
          DEVICE=$(xcrun simctl list devices available | grep -oE 'iPhone [^(]+' | head -1 | xargs)
          if [ -z "$DEVICE" ]; then
            echo "::error::No available iPhone simulator found on runner"
            exit 1
          fi
          echo "device=$DEVICE" >> "$GITHUB_OUTPUT"
          echo "Selected simulator: $DEVICE"

      - name: Run full test suite
        run: |
          xcodebuild test \
            -scheme Pencild \
            -destination "platform=iOS Simulator,name=${{ steps.sim.outputs.device }}"
